---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/site';
---
<BaseLayout title="Not found" description="Page not found.">
  <section class="py-28 text-center">
    <p class="text-xs font-medium uppercase tracking-[0.18em] text-base-500">404</p>
    <h1 class="mt-4 text-4xl font-medium">Page not found</h1>
    <a class="mt-6 inline-block text-sm underline" href={withBase('/')}>Back to posts</a>
  </section>
</BaseLayout>
