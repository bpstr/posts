---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogEntry from '@/components/entries/BlogEntry.astro';
import { getCollection } from 'astro:content';
import { withBase } from '@/lib/site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<BaseLayout>
  <section class="py-20 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-base-500">Engineering notes</p>
      <h1 class="mt-4 text-balance text-4xl font-medium tracking-tight text-base-900 sm:text-5xl">Software systems, AI, architecture, and the web.</h1>
      <p class="mt-5 max-w-xl text-sm leading-6 text-base-600">Long-form notes on building software, understanding existing systems, and the interfaces emerging around AI agents.</p>
    </div>

    <div class="mt-8 flex flex-wrap gap-x-4 gap-y-2">
      {tags.map((tag) => <a class="text-xs font-medium text-base-500 hover:text-base-900" href={withBase(`/tags/${tag}/`)}>#{tag}</a>)}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2">
      {posts.map((entry) => <BlogEntry entry={entry} />)}
    </div>
  </section>
</BaseLayout>
